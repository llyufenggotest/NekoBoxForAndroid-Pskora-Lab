<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lab_surface"
    android:orientation="vertical">

    <include layout="@layout/layout_appbar" />

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
    <!-- Test/metrics/tabs collapse with the node list; the connection panel above does not. -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/dashboard_scroll_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/lab_surface"
            app:elevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_scrollFlags="scroll|enterAlways">
                <View android:layout_width="match_parent" android:layout_height="72dp" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/dashboard_test_card"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginStart="@dimen/lab_content_inset"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="@dimen/lab_content_inset"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/lab_surface_elevated"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="14dp">

                        <TextView
                            android:id="@+id/dashboard_test_profile_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="未选择节点"
                            android:textColor="@color/lab_text_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/dashboard_test_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="点击测试  ›"
                            android:textColor="@color/lab_text_tertiary"
                            android:textSize="11sp"
                            android:textStyle="normal" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginStart="@dimen/lab_content_inset"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="@dimen/lab_content_inset"
                    android:orientation="horizontal">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                                            <TextView android:id="@+id/dashboard_latency" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:text="-- ms" android:textSize="16sp" android:textColor="@color/lab_text_primary" />
                                            <TextView android:id="@+id/dashboard_latency_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="实时延迟" android:textSize="11sp" android:textColor="@color/lab_text_secondary" />
                                        </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                                            <TextView android:id="@+id/dashboard_upload" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:text="0 B/s" android:textSize="16sp" android:textColor="@color/lab_text_primary" />
                                            <TextView android:id="@+id/dashboard_upload_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="上传" android:textSize="11sp" android:textColor="@color/lab_text_secondary" />
                                        </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                                            <TextView android:id="@+id/dashboard_download" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:maxLines="1" android:ellipsize="end" android:text="0 B/s" android:textSize="16sp" android:textColor="@color/lab_text_primary" />
                                            <TextView android:id="@+id/dashboard_download_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="下载" android:textSize="11sp" android:textColor="@color/lab_text_secondary" />
                                        </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/group_tab"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@color/lab_surface"
                app:layout_scrollFlags="scroll|enterAlways"
                app:tabTextColor="@color/lab_text_secondary"
                app:tabSelectedTextColor="@color/lab_text_primary"
                app:tabIndicatorColor="#536EA8"
                app:tabGravity="start"
                app:tabIndicatorFullWidth="false"
                app:tabMode="scrollable"
                app:tabTextAppearance="@style/LabCompactLabel"
                tools:ignore="SpeakableTextPresentCheck" />
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/group_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <!-- Only this compact connection panel stays fixed. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/dashboard_connection_card"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginStart="@dimen/lab_content_inset"
        android:layout_marginEnd="@dimen/lab_content_inset"
        app:cardBackgroundColor="@color/lab_surface_elevated"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:id="@+id/dashboard_connection_state" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="等待连接" android:textColor="@color/lab_text_secondary" android:textSize="11sp" />
                    <TextView android:id="@+id/dashboard_connection_action" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:maxLines="1" android:ellipsize="end" android:text="点击连接 VPN" android:textColor="@color/lab_text_secondary" android:textSize="11sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="3dp" android:baselineAligned="false">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="本次上传" android:textSize="10sp" android:textColor="@color/lab_text_secondary" />
                        <TextView android:id="@+id/dashboard_session_upload" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:includeFontPadding="false" android:fontFeatureSettings="tnum" android:text="0 B" android:textSize="21sp" android:textStyle="bold" android:textColor="@color/lab_text_primary" app:autoSizeTextType="uniform" app:autoSizeMinTextSize="16sp" app:autoSizeMaxTextSize="21sp" app:autoSizeStepGranularity="1sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="本次下载" android:textSize="10sp" android:textColor="@color/lab_text_secondary" />
                        <TextView android:id="@+id/dashboard_session_download" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:includeFontPadding="false" android:fontFeatureSettings="tnum" android:text="0 B" android:textSize="21sp" android:textStyle="bold" android:textColor="@color/lab_text_primary" app:autoSizeTextType="uniform" app:autoSizeMinTextSize="16sp" app:autoSizeMaxTextSize="21sp" app:autoSizeStepGranularity="1sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/dashboard_connection_button"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:clickable="true"
                android:contentDescription="连接开关"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                app:cardBackgroundColor="@color/lab_control_idle_background"
                app:strokeWidth="0dp"
                app:cardCornerRadius="27dp"
                app:cardElevation="0dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/dashboard_connection_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    app:srcCompat="@drawable/ic_service_idle"
                    app:tint="@color/lab_control_idle_foreground" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    </FrameLayout>
</LinearLayout>