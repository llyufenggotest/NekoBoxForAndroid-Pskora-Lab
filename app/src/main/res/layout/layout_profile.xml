<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/lab_content_inset"
    android:layout_marginVertical="4dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp"
    app:rippleColor="?attr/colorControlHighlight"
    app:strokeWidth="0dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="top"
            android:background="@color/lab_divider" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="bottom"
            android:background="@color/lab_divider" />

        <LinearLayout
            android:id="@+id/content_lin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/profile_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:breakStrategy="simple"
                    android:ellipsize="end"
                    android:hyphenationFrequency="none"
                    android:lineBreakStyle="loose"
                    android:lineBreakWordStyle="phrase"
                    android:maxLines="2"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="4dp"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:textColor="?android:attr/textColorPrimary"
                    tools:text="@string/profile_name" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/edit"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/edit"
                    android:focusable="true"
                    android:padding="14dp"
                    app:srcCompat="@drawable/ic_profile_edit_outline" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/double_column_menu"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/profile_more_actions_description"
                    android:focusable="true"
                    android:padding="14dp"
                    android:visibility="gone"
                    app:srcCompat="@drawable/ic_baseline_more_vert_24" />

                <LinearLayout
                    android:id="@+id/share"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/share"
                    android:focusable="true"
                    android:gravity="center"
                    android:nextFocusLeft="@+id/container">

                    <LinearLayout
                        android:id="@+id/share_layer"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/shareIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/ic_profile_share_outline" />
                    </LinearLayout>
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/remove"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/delete"
                    android:focusable="true"
                    android:padding="14dp"
                    android:visibility="gone"
                    app:srcCompat="@drawable/ic_profile_delete_outline" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/profile_address"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/server_address"
                    android:textAppearance="@style/LabProfileMetadata"
                    android:textColor="@color/profile_card_secondary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/profile_metadata_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp">

                <TextView
                    android:id="@+id/profile_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/LabProfileMetadata"
                    android:textColor="@color/profile_card_secondary"
                    tools:text="VLESS" />

                <TextView
                    android:id="@+id/profile_preferred_group"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/profile_preferred_group_description"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/LabProfileMetadata"
                    android:textColor="@color/profile_card_accent"
                    android:visibility="gone"
                    tools:text="Preferred · Streaming"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/profile_latency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@string/profile_latency_description"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/LabProfileMetadata"
                    android:textColor="@color/profile_card_accent"
                    android:visibility="gone"
                    tools:text="48 ms"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/profile_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:maxLines="1"
                    android:textAppearance="@style/LabProfileMetadata"
                    android:textColor="@color/profile_card_secondary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/profile_traffic_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:paddingBottom="5dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/profile_upload_speed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="@string/profile_upload_speed_description"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/LabProfileMetadata"
                    android:textColor="@color/profile_card_secondary"
                    tools:text="↑ 1.2 MB/s" />

                <TextView
                    android:id="@+id/profile_download_speed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/profile_download_speed_description"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:maxLines="1"
                    android:textAppearance="@style/LabProfileMetadata"
                    android:textColor="@color/profile_card_secondary"
                    tools:text="↓ 8.4 MB/s" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/profile_quality_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal"
                android:paddingEnd="4dp"
                android:visibility="gone">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/profile_leaf"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/profile_leaf_description"
                    android:padding="14dp"
                    app:srcCompat="@drawable/ic_profile_leaf_outline" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/profile_speedometer"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/profile_speedometer_description"
                    android:padding="14dp"
                    app:srcCompat="@drawable/ic_profile_speedometer_outline" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/profile_lightning"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/profile_lightning_description"
                    android:padding="14dp"
                    app:srcCompat="@drawable/ic_profile_lightning_outline" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:id="@+id/selected_indicator"
            android:layout_width="4dp"
            android:layout_height="34dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="3dp"
            android:background="?attr/selectedColorPrimary"
            android:visibility="gone"
            tools:visibility="visible" />
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
