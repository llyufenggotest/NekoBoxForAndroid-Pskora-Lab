<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/lab_window_background">
<include layout="@layout/layout_appbar"/>
<ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingBottom="156dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/lab_content_inset">
<com.google.android.material.card.MaterialCardView android:id="@+id/share_ring" android:layout_width="64dp" android:layout_height="64dp" android:layout_gravity="center_horizontal" android:layout_marginTop="4dp" app:cardCornerRadius="32dp" app:cardElevation="0dp" app:cardBackgroundColor="@android:color/transparent" app:strokeWidth="2dp" app:strokeColor="@color/lab_ring"><ImageView android:id="@+id/share_state_icon" android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="center" android:src="@drawable/ic_share_network" android:contentDescription="共享状态"/></com.google.android.material.card.MaterialCardView>
<TextView android:id="@+id/share_running_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="6dp" android:text="共享已关闭" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/lab_text_primary"/>
<TextView android:id="@+id/share_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="2dp" android:maxLines="1" android:ellipsize="end" android:textSize="11sp" android:textColor="@color/lab_text_secondary"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_marginBottom="6dp" android:text="共享服务" android:textSize="13sp" android:textColor="@color/lab_text_primary"/>
<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/lab_surface_elevated" app:cardCornerRadius="16dp" app:cardElevation="0dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="14dp" android:paddingEnd="14dp" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="局域网共享\nHTTP / SOCKS 混合代理" android:textSize="13sp" android:textColor="@color/lab_text_primary"/><androidx.appcompat.widget.SwitchCompat android:id="@+id/share_switch" android:layout_width="wrap_content" android:layout_height="44dp" android:contentDescription="局域网共享开关"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:gravity="center_vertical"><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Wi-Fi IPv4 地址" android:textColor="@color/lab_text_primary" android:textSize="13sp"/><TextView android:id="@+id/wifi_address" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="未检测到" android:textColor="@color/lab_text_secondary" android:textSize="12sp"/></LinearLayout><Button android:id="@+id/copy_wifi" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="58dp" android:layout_height="44dp" android:text="复制" android:textSize="12sp"/></LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:gravity="center_vertical"><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="热点路由器 IPv4 地址" android:textColor="@color/lab_text_primary" android:textSize="13sp"/><TextView android:id="@+id/hotspot_address" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="未检测到" android:textColor="@color/lab_text_secondary" android:textSize="12sp"/></LinearLayout><Button android:id="@+id/copy_hotspot" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="58dp" android:layout_height="44dp" android:text="复制" android:textSize="12sp"/></LinearLayout>
<LinearLayout android:id="@+id/share_auth_row" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true"><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="访问认证" android:textSize="13sp" android:textColor="@color/lab_text_primary"/><TextView android:id="@+id/share_auth_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/lab_text_secondary"/></LinearLayout><TextView android:id="@+id/share_auth_state" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="?colorPrimary"/></LinearLayout>
</LinearLayout></com.google.android.material.card.MaterialCardView>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_marginBottom="6dp" android:text="正在使用代理" android:textSize="13sp" android:textColor="@color/lab_text_primary"/>
<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/lab_surface_elevated" app:cardCornerRadius="16dp" app:cardElevation="0dp"><TextView android:id="@+id/share_clients" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="84dp" android:gravity="center" android:padding="@dimen/lab_content_inset" android:text="等待连接数据" android:textColor="@color/lab_text_secondary" android:textSize="12sp"/></com.google.android.material.card.MaterialCardView>
</LinearLayout></ScrollView></LinearLayout>