<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minWidth="184dp" android:minHeight="48dp"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="14dp" android:paddingEnd="14dp"
    android:paddingTop="8dp" android:paddingBottom="8dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true" android:focusable="true">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/group_action_icon"
        android:layout_width="24dp" android:layout_height="24dp"
        android:layout_marginEnd="12dp" android:importantForAccessibility="no"
        app:tint="?android:attr/textColorSecondary" />
    <TextView android:id="@+id/group_action_title"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="14sp" android:textStyle="normal"
        android:textColor="?android:attr/textColorPrimary" />
</LinearLayout>
